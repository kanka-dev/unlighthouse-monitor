# Public URL of the dashboard. Used in Mattermost messages and as link target.
# REQUIRED if MATTERMOST_WEBHOOK_URL is set, otherwise links will be wrong.
PUBLIC_URL=https://unlighthouse.example.com

# Mattermost Incoming Webhook (optional). If empty, notifications are skipped.
# https://docs.mattermost.com/developer/webhooks-incoming.html
MATTERMOST_WEBHOOK_URL=

# Timezone for cron schedule. Default: UTC
TZ=Europe/Berlin
